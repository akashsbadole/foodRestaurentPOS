{
  "performance_settings": {
    "database_optimization": {
      "connection_pooling": {
        "enabled": true,
        "pool_size": 10,
        "max_overflow": 20,
        "pool_timeout": 30,
        "pool_recycle": 3600
      },
      "query_optimization": {
        "use_indexes": true,
        "explain_analyze": false,
        "selective_loading": true,
        "batch_operations": true
      },
      "caching": {
        "enabled": true,
        "type": "memory",
        "default_ttl": 300,
        "max_size": 1000,
        "compression": true
      }
    },
    "ui_optimization": {
      "lazy_loading": {
        "images": true,
        "menu_items": true,
        "data_lists": true,
        "background_tasks": true
      },
      "rendering": {
        "virtual_scrolling": true,
        "widget_reuse": true,
        "progressive_loading": true,
        "debounce_events": true
      },
      "memory_management": {
        "enabled": true,
        "garbage_collection": true,
        "object_pooling": true,
        "streaming_data": true
      }
    },
    "web_optimization": {
      "resource_loading": {
        "css_minification": true,
        "js_minification": true,
        "image_optimization": true,
        "compression": true
      },
      "caching": {
        "browser_cache": true,
        "cdn_integration": false,
        "etag_support": true,
        "gzip_compression": true
      },
      "pagination": {
        "enabled": true,
        "default_page_size": 50,
        "max_page_size": 200,
        "infinite_scroll": false
      }
    },
    "monitoring": {
      "performance_metrics": {
        "enabled": true,
        "collection_interval": 60,
        "memory_usage": true,
        "response_times": true,
        "database_queries": true
      },
      "alerts": {
        "enabled": true,
        "memory_threshold_warning": 80,
        "memory_threshold_critical": 90,
        "response_time_threshold": 5000,
        "error_rate_threshold": 5
      }
    },
    "profiles": {
      "low_resource": {
        "database_pool_size": 5,
        "page_size": 25,
        "cache_timeout": 600,
        "lazy_loading": true,
        "background_threads": 2,
        "image_quality": "medium"
      },
      "medium_resource": {
        "database_pool_size": 10,
        "page_size": 50,
        "cache_timeout": 300,
        "lazy_loading": true,
        "background_threads": 4,
        "image_quality": "high"
      },
      "high_resource": {
        "database_pool_size": 20,
        "page_size": 100,
        "cache_timeout": 60,
        "lazy_loading": true,
        "background_threads": 8,
        "image_quality": "high"
      },
      "balanced": {
        "database_pool_size": 10,
        "page_size": 50,
        "cache_timeout": 300,
        "lazy_loading": true,
        "background_threads": 4,
        "image_quality": "high"
      }
    }
  },
  "current_profile": "balanced",
  "auto_optimization": {
    "enabled": true,
    "detect_resources": true,
    "adjust_settings": true,
    "profile_switching": true
  }
}